# Set to "anthropic" (default), "openai", or "ollama".
AI_PROVIDER=anthropic

# SQLite path. Docker Compose overrides this to /data/strength.db.
DATABASE_PATH=./strength.db

# Anthropic configuration (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI configuration (used when AI_PROVIDER=openai)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# All AI operations, including on-demand workouts, use AI_PROVIDER.
# Ollama needs no cloud API key. Install/pull the model explicitly.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_NUM_CTX=32768

# Daily dispatched-attempt cap applies to every provider.
ON_DEMAND_WORKOUT_DAILY_CAP=5
APP_TIMEZONE=America/Regina
